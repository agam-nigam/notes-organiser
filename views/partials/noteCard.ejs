<!-- title -->
<div class="note">
    Title:
    <p class="details title-text" title="<%= note.title %>"><%= note.title %></p>
</div>

<!-- content -->
<div class="note">
    Content:
    <p class="details content-text"><%= note.content.length > 100 ? note.content.substring(0, 100) + "..." : note.content %></p>
    <% if (note.content.split('\n').length > 4 || note.content.length > 100) { %>
        <button class="read-more-btn" onclick="openModal('<%= note._id %>')">Read More</button>
    <% } %>
</div>

<!-- modal -->
<div class="modal-overlay" id="modal-<%= note._id %>">
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title"><%= note.title %></span>
            <button class="modal-close" onclick="closeModal('<%= note._id %>')">&times;</button>
        </div>
        <div class="modal-content"><%= note.content %></div>
    </div>
</div>

<!-- time -->
<% const isUpdated = note.updatedAt && note.updatedAt > note.createdAt;
   const date = isUpdated ? note.updatedAt : note.createdAt;
%>
<div class="note note-time">
  <span class="time-label"><%= isUpdated ? "Updated:" : "Created:" %></span>
  <span class="time-label">
    <%= new Date(date).toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' }) %> <br />
    <%= new Date(date).toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' }) %>
  </span>
</div>

<!-- footer -->
<div class="note-footer">
    <form action="/notes/<%= note._id %>/edit" method="get">
        <button type="submit">Edit</button>
    </form>

    <form action="/notes/<%= note._id %>?_method=DELETE" method="post">
        <button type="submit"
            onclick="return confirm(`This action can't be reverted back. Are you sure to delete?`)">
            Delete
        </button>
    </form>

    <form action="/notes/<%= note._id %>?_method=PATCH" method="post">
        <button type="submit">
            <%= note.pinned ? "Unpin" : "Pin" %>
        </button>
    </form>
</div>

<script>
function openModal(id) {
    document.getElementById("modal-" + id).classList.add("active");
    document.body.style.overflow = "hidden";
}

function closeModal(id) {
    document.getElementById("modal-" + id).classList.remove("active");
    document.body.style.overflow = "auto";
}

document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".modal-overlay").forEach(modal => {
        modal.addEventListener("click", function(e) {
            if (e.target === this) {
                modal.classList.remove("active");
                document.body.style.overflow = "auto";
            }
        });
    });
});
</script>