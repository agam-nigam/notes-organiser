<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new note</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="form-page">

    <h2>Create a New Note</h2>

    <form action="/notes" method="post">
        <input type="text" name="title" placeholder="Add title here" maxlength="100" required />
        <textarea name="content" rows="10" cols="30" placeholder="Add notes here"></textarea>
        <%- include("partials/colorPicker") %>

            <button type="submit" onclick="return confirm('Do you want to save this note?')">Add!</button>
    </form>

    <%- include("partials/footer") %>
    <script>
        const form = document.querySelector("form");

        form.addEventListener("submit", (e) => {
            const title = form.title.value.trim();
            const content = form.content.value.trim();

            if (!title && !content) {
                e.preventDefault();
                alert("Note cannot be empty.");
            }
        });
    </script>
</body>

</html>